# Credenciais: deixe vazio se você usa `ant auth login`.
ANTHROPIC_API_KEY=

# Venice (opcional): com a chave, o seletor oferece o DeepSeek V4.1 Flash Uncensored.
# VENICE_API_KEY=
# VENICE_BASE_URL=https://api.venice.ai/api/v1

# Mestre (padrões entre parênteses)
# CRPS_MODEL=claude-opus-5-5     # ou venice/deepseek-v4-1-flash-uncensored
# CRPS_VERIFIER_MODEL=claude-haiku-5-5
# CRPS_EFFORT_SETUP=medium      # criação do mundo: low | medium | high | xhigh | max
# CRPS_EFFORT_TURN=low          # turnos: menos esforço = respostas mais rápidas
# CRPS_VERIFY=1                 # 0 desliga o verificador de consistência
# CRPS_PROVIDER=claude          # offline = roteiro fixo, sem modelo

# Servidor
# CRPS_SAVES=saves
# CRPS_API_PORT=8787
