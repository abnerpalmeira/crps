{
  "name": "crps",
  "version": "0.1.0",
  "private": true,
  "description": "Computerized Role-Playing System: a IA narra, o motor guarda o estado.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "demo": "CRPS_PROVIDER=offline CRPS_SAVES=saves/demo CRPS_API_PORT=8788 npm run dev",
    "demo:release": "CRPS_MODE=release npm run demo",
    "teste": "CRPS_SAVES=saves/teste CRPS_API_PORT=8790 concurrently -k -n server,web -c blue,green \"tsx watch src/server/index.ts\" \"vite --port 5175 --strictPort\"",
    "play": "tsx src/cli.ts",
    "start": "vite build && CRPS_MODE=release tsx src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "assets": "blender -b --python-exit-code 1 --python scripts/assets/convert_synty.py -- scripts/assets/synty.json assets/synty public/models"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
